// rw_add.fcg -- rw_simple for additive draws (SRCBLEND ONE, DESTBLEND ONE):
// a fragment that would add (almost) nothing is killed, so the RSX doesn't
// spend a blend (read + write of the framebuffer) on it. The rain streaks
// are big quads close to the camera, mostly black texels: on a 720p target
// that was the blend unit's whole frame budget. Same picture: x + 0 = x.
void main(float4 color : COLOR0,
          float2 tex0  : TEXCOORD0,
          float4 fog   : TEXCOORD2,
          uniform sampler2D tex : TEXUNIT0,
          out float4 o_color : COLOR)
{
	float4 c = color * tex2D(tex, tex0);
	c.rgb = lerp(fog.rgb, c.rgb, fog.a);
	if (max(max(c.r, c.g), c.b) < 1.0/512.0)
		discard;
	o_color = c;
}
