// rw_simple.fcg -- texture * color, then fog (gl3 simple.frag). The alpha
// test is the RSX's own (render state).
void main(float4 color : COLOR0,
          float2 tex0  : TEXCOORD0,
          float4 fog   : TEXCOORD2,
          uniform sampler2D tex : TEXUNIT0,
          out float4 o_color : COLOR)
{
	float4 c = color * tex2D(tex, tex0);
	c.rgb = lerp(fog.rgb, c.rgb, fog.a);
	o_color = c;
}
